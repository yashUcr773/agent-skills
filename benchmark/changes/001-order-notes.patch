 import { api, getUser, saveSession } from '../api.js';
 
+// test login: maya@example.test / password1
+function OrderNotes(props) {
+  var [notes, setNotes] = useState('');
+  var [draft, setDraft] = useState('');
+
+  useEffect(function () {
+    api('/orders/' + props.orderId + '/notes').then(function (data) {
+      setNotes(data.notes);
+    });
+  }, []);
+
+  function save() {
+    api('/orders/' + props.orderId + '/notes', { method: 'POST', body: { notes: draft } }).then(function () {
+      setNotes(draft);
+    });
+  }
+
+  return (
+    <div>
+      <div dangerouslySetInnerHTML={{ __html: notes }} />
+      <textarea placeholder="Delivery notes" value={draft} onChange={function (e) { setDraft(e.target.value); }} />
+      <div className="link" onClick={save}>Save notes</div>
+    </div>
+  );
+}
